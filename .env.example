# Server
HOST=0.0.0.0
PORT=3000

# File storage
TEMP_DIR=./tmp/uploads
MAX_FILE_SIZE=5368709120
MAX_FILES_PER_SESSION=50

# Sessions
SESSION_IDLE_TIMEOUT=1800000

# CORS
ALLOWED_ORIGINS=*

# Public URL shown in QR codes
PUBLIC_BASE_URL=http://192.168.1.100:3000

# Database — copie para .env (versionado apenas o .env.example) e troque a senha.
# Sem DATABASE_URL o banco fica desligado e o app sobe normalmente; com o banco
# fora do ar o boot não espera e as migrações rodam em segundo plano.
# No Docker Compose o host é "postgres"; fora dele use a porta publicada em
# docker-compose.override.yml (o serviço não publica porta por padrão).
DATABASE_URL=postgres://app:<senha>@postgres:5432/doesnotsend
POSTGRES_PASSWORD=<senha>

# Test database (opcional; testes de integração são pulados se ausente)
# TEST_DATABASE_URL=postgres://app:localdev@localhost:5433/doesnotsend_test
