# Server
HOST=0.0.0.0
PORT=3000

# File storage
TEMP_DIR=./tmp/uploads
MAX_FILE_SIZE=5368709120
MAX_FILES_PER_SESSION=50

# Sessions
SESSION_IDLE_TIMEOUT=1800000

# CORS
ALLOWED_ORIGINS=*

# Public URL shown in QR codes
PUBLIC_BASE_URL=http://192.168.1.100:3000

# Database (produção: use uma senha forte e mantenha fora do repositório)
# Ex.: DATABASE_URL=postgres://app:SENHA_SEGURA@postgres:5432/doesnotsend
DATABASE_URL=postgres://app:localdev@postgres:5432/doesnotsend
POSTGRES_PASSWORD=localdev

# Test database (opcional; testes de integração são pulados se ausente)
# TEST_DATABASE_URL=postgres://app:testpass@localhost:5433/doesnotsend_test
