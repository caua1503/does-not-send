{
  "name": "does-not-send",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "bun --bun run src/server.ts",
    "dev:web": "cd web && bun run dev",
    "start": "bun --bun run src/server.ts",
    "build:web": "cd web && bun run build",
    "test": "bun --bun vitest run",
    "test:web": "cd web && bun run test",
    "test:watch": "bun --bun vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "cd web && bun run typecheck",
    "smoke": "PUBLIC_BASE_URL=${PUBLIC_BASE_URL:-http://localhost} bun run scripts/smoke.ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "bun-types": "^1.4.4",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.8",
    "vitest": "^5.0.5"
  }
}
